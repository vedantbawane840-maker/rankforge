{
  "name": "rankforge",
  "version": "1.0.0",
  "description": "RankForge — Model Context Protocol (MCP) Server SaaS for AI Coding Agents",
  "scripts": {
    "dev:pages": "wrangler pages dev pages/",
    "dev:worker": "cd workers/mcp-server && wrangler dev",
    "deploy:pages": "wrangler pages deploy pages/ --project-name rankforgeapp",
    "deploy:worker": "cd workers/mcp-server && wrangler deploy",
    "deploy:all": "npm run deploy:pages && npm run deploy:worker",
    "typecheck": "cd workers/mcp-server && npm run typecheck",
    "test": "cd workers/mcp-server && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seo",
    "aeo",
    "geo",
    "cloudflare-workers",
    "cloudflare-pages",
    "cursor",
    "claude-code",
    "windsurf",
    "cline",
    "dodo-payments"
  ],
  "author": "RankForge Team",
  "license": "MIT"
}
